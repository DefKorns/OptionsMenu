# shellcheck source=/dev/null
source /etc/preinit
script_init

# PATHS
nand_path="$rootfs/usr/share"
share_path="$mountpoint/usr/share"
ui_path="$share_path/ui"
cloverui_path="$share_path/clover-ui/"
string_path="resources/strings"
root_bin="$rootfs/bin"
usb_path="$mountpoint/media/$modname"
font_dir="$usb_path/fonts"
mod_state_path="$mountpoint$profilepath/$modname"
[ ! -d "$font_dir" ] && font_dir="$nand_path/fonts"


system="$sftype"
s_type="$system"
core="$sftype"
case "$sftype" in
hvcj)
  system="shonen"
  s_type="$system"
  system_string="$ui_path/hvc/$string_path"
  core="nes"
  ;;
nes)
  if [ "$sfregion" = "jpn" ]; then
    system="hvc"
    s_type="$system"
    system_string="$cloverui_path/$string_path"
  fi
  ;;
snes)
  system_string="$ui_path/$sftype-$sfregion/$string_path"
  if [ "$sfregion" = "jpn" ]; then
    system="shvc"
    system_string="$ui_path/$system/$string_path"
  fi
  ;;
esac

# OM PATHS
options_menu="$mountpoint/etc/options_menu"
om_commands="$options_menu/commands"
om_scripts="$options_menu/scripts"
om_images="$options_menu/images"

# FUNCTIONS
game_storage="$(findGameStorage)"

rename() {
  [ -f "$1" ] && mv "$1" "$2"
}

# language.cfg, else Console Language's, else the console's
omLangCode() {
  local code
  code="$(cat "$options_menu/language.cfg" 2>/dev/null)"
  if [ -z "$code" ]; then
    code="$(cat /var/console_language_ui 2>/dev/null)"
    [ -n "$code" ] || code="$(cat /var/lib/clover/profiles/0/lang.txt 2>/dev/null)"
    code="$(omLangFor "$code")"
  fi
  echo "${code:-en-US}"
}

# the xx-YY menu language for a console language code (ja_JPN, pt_br, pt_EUR, sv...): the region the
# code names (pt_br is pt-BR), else the language's own (pt-PT), else the first
omLangFor() {
  local lang
  local region
  local file
  lang="$(echo "$1" | cut -c1-2)"
  [ -n "$lang" ] || return 0
  region="$(echo "$1" | cut -s -d_ -f2 | tr '[:lower:]' '[:upper:]')"
  for file in "$options_menu/language/$lang-$region.lang" "$options_menu/language/$lang-$(echo "$lang" | tr '[:lower:]' '[:upper:]').lang"; do
    [ -f "$file" ] && { basename "$file" .lang; return 0; }
  done
  for file in "$options_menu/language/$lang"-*.lang; do
    [ -f "$file" ] && { basename "$file" .lang; return 0; }
  done
}

# value, own name and preview of each menu language, for the CHOICE row
omLangList() {
  local lang_file
  local code
  for lang_file in "$options_menu"/language/*.lang; do
    code="$(basename "$lang_file" .lang)"
    printf '%s\t%s\t%s\n' "$code" "$(grep '^LANGUAGE_NAME=' "$lang_file" | head -n 1 | cut -d= -f2-)" "$options_menu/images/preview_lang_${code%%-*}.png"
  done
}

translate() {
  local key="$1"
  local lang_code
  local lang_dir
  local value=""
  lang_code="$(omLangCode)"

  for lang_dir in "$options_menu/language" "$options_menu"/*/lang; do
    [ -z "$value" ] && [ -f "$lang_dir/$lang_code.lang" ] && value="$(grep "^${key}=" "$lang_dir/$lang_code.lang" 2>/dev/null | tail -1 | cut -d= -f2-)"
    [ -z "$value" ] && [ -f "$lang_dir/en-US.lang" ] && value="$(grep "^${key}=" "$lang_dir/en-US.lang" 2>/dev/null | tail -1 | cut -d= -f2-)"
  done
  [ -z "$value" ] && value="$key"
  echo "$value"
}

remove() {
  local target
  for target in "$@"; do
    [ -f "$target" ] || [ -d "$target" ] && rm -rf "$target"
  done
}

link() {
  [ -f "$1" ] && ln -sf "$1" "$2"
}

copier() {
  [ -f "$1" ] && cp -r "$1" "$2"
}

create() {
  [ ! -f "$1" ] && touch "$1"
}

enableCmds() {
  local cmd_name
  for cmd_name in "$@"; do
    eval "rename \"\$disable_$cmd_name\" \"\$enable_$cmd_name\""
  done
}

disableCmds() {
  local cmd_name
  for cmd_name in "$@"; do
    eval "rename \"\$enable_$cmd_name\" \"\$disable_$cmd_name\""
  done
}

# two providers, so one being down or blocked isn't read as offline
hasInternet() {
  local host
  ip route 2>/dev/null | grep -q '^default' || return 1
  for host in connectivitycheck.gstatic.com cloudflare.com; do
    nc -z -w 3 "$host" 443 >/dev/null 2>&1 && return 0
  done
  return 1
}

netChecker() {
  if hasInternet; then
    translate NO_PKG_ERR
  else
    translate NO_NET_ERR
  fi
}

toggleDownloads() {
  if hasInternet; then
    enableCmds "downloads"
  else
    disableCmds "downloads"
  fi
}

# downloader exit codes: 0 ok, 1 network/server, 2 usage, 3 no space, 143 cancelled
downloadError() {
  case "$1" in
    0 | 143) ;;
    3) translate NOT_ENOUGH_SPACE ;;
    *) netChecker ;;
  esac
}

# omDownload <out_path> <url> [fallback_url...]
omDownload() {
  local rc
  "$om_scripts/downloader" --progress --free-label "$(translate FREE_SPACE)" "$@" 2>&1
  rc=$?
  downloadError "$rc"
  return "$rc"
}

# omDownloadAll <list_file> <handler> [keep]
# runs "<handler> <rc> <out_path>" per item; with keep > 0 it must delete the file; 3 stops the batch
omDownloadAll() {
  local fifo="/tmp/om_download.$$" dl_pid dl_rc rc=0 item_rc item stale
  for stale in /tmp/om_download.*; do
    [ -p "$stale" ] && [ ! -d "/proc/${stale##*.}" ] && rm -f "$stale"
  done
  rm -f "$fifo"
  mkfifo "$fifo" || return 1
  # progress (stderr) to the screen, results (stdout) to the fifo
  # shellcheck disable=SC2069
  "$om_scripts/downloader" --progress --free-label "$(translate FREE_SPACE)" --keep "${3:-0}" --batch "$1" 2>&1 > "$fifo" &
  dl_pid=$!
  while read -r item_rc item; do
    "$2" "$item_rc" "$item"
    [ "$?" = 3 ] && rc=3 && break
  done < "$fifo"
  kill "$dl_pid" 2> /dev/null
  wait "$dl_pid"
  dl_rc=$?
  [ "$dl_rc" = 3 ] && rc=3
  rm -f "$fifo"
  return "$rc"
}

# omSplash <key...>: one translated line per key, drawn straight to the screen
omSplash() {
  "$om_scripts/gen_splash" /tmp/om_splash.png "$@" && decodepng /tmp/om_splash.png >/dev/fb0
}

# omLoading [key...]: omSplash plus a moving bar until the calling script exits; "Loading" without keys
omLoading() {
  om_loading_keys="$*"
  "$om_scripts/gen_splash" --loading "$@" 2>/dev/null
}

# omFreeKb <dir>
omFreeKb() {
  df -Pk "$1" | awk 'NR==2 {print $4}'
}

# omUnpackedKb <tar.gz>: the size in the gzip trailer, plus 10% for the filesystem
omUnpackedKb() {
  local size_kb=$(($(tail -c4 "$1" | od -An -tu4) / 1024 + 1))
  echo $((size_kb + size_kb / 10))
}

# omUnpack <tar.gz> <dir>: 0 unpacked, 1 broken, 3 no space left (downloadError's codes); removes the tarball
omUnpack() {
  local rc=0
  if [ "$(omFreeKb "$2")" -lt "$(omUnpackedKb "$1")" ]; then
    rc=3
    gzip -t "$1" 2>/dev/null || rc=1
  elif ! tar -xzf "$1" -C "$2"; then
    rc=1
    [ "$(omFreeKb "$2")" -lt 1024 ] && rc=3
  fi
  rm -f "$1"
  return "$rc"
}

# omReloadMenuLater [command...]: the menu holds /dev/fb0 and uistop kills every holder,
# so remote-exec runs omReloadMenu once the caller has exited
omReloadMenuLater() {
  echo "source $om_scripts/om_functions; om_loading_keys=\"$om_loading_keys\"; omReloadMenu $*" >/var/exec.flag.tmp
  mv /var/exec.flag.tmp /var/exec.flag
}

# omReloadMenu [command...]: stops the UI, shows Loading, runs the command, then reloads the current folder;
# chmenu refuses the folder already shown unless its state says otherwise
omReloadMenu() {
  local menu_state="/var/saves/$modname/menu" current_menu="000"
  rm -f /tmp/options.flag
  uistop
  uiresume
  timeout="" waittimeout 1500 '! lsof -n | grep -qF "/dev/fb0"' "framebuffer"
  # shellcheck disable=SC2086
  omLoading ${om_loading_keys:-LOADING}
  [ $# -gt 0 ] && "$@"
  [ -f "$menu_state" ] && current_menu="$(cat "$menu_state")"
  echo reload >"$menu_state"
  /bin/chmenu "$current_menu" || /bin/chmenu 000 || {
    echo "$current_menu" >"$menu_state"
    uistart
  }
}

overlayFS() {
  [ -d "$1" ] && mount -t overlayfs -o lowerdir="$2",upperdir="$1" overlayfs "$2"
}
