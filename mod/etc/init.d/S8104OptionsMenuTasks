# the home menu only reads <code>.png and _small.png
cleanExtraCovers() {
  game_storage="$(findGameStorage)"
  [ -d "$game_storage" ] || return 0
  find "$game_storage" -type f \( -name "*_mdmini.png" -o -name "*_original.png" \) -exec rm -f {} +
}

# left by RetroArch hmods' install, missed by their uninstall
cleanRetroarchDefaults() {
  [ -e /bin/retroarch ] || [ -e /bin/retroarch-clover ] && return 0
  rm -rf "$mountpoint/etc/options_menu/retroarch/default_files"
}

# the console restarts after every Hakchi sync, so each new game is seen before it can be removed
# $1 is rcS's pid
rememberGameNames() {
  timeout=120000 waittimeout 120000 "! kill -0 $1 2>/dev/null"
  sh /etc/options_menu/scripts/OrphanSaves.sh sync-names
}

tasks() {
  source /etc/preinit
  script_init

  cleanExtraCovers
  cleanRetroarchDefaults
  rememberGameNames "$1"
}

case "$1" in
start)
	tasks "$PPID" &
;;
stop|restart)
;;
*)
	echo "OptionsMenuTasks: Please use start."
	exit 1
;;
esac
